---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'ru';
  alternateHref?: string;
}

const { title, description, lang = 'en', alternateHref } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isRu = lang === 'ru';
const homeHref = isRu ? '/ru/' : '/';
const notesHref = isRu ? '/ru/notes/' : '/notes/';
const topicsHref = isRu ? '/ru/topics/' : '/topics/';
const rssHref = isRu ? '/ru/rss.xml' : '/rss.xml';
const languageHref = alternateHref ?? (isRu ? '/' : '/ru/');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content="Tudor Shandrov" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={isRu ? 'en' : 'ru'} href={new URL(languageHref, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={isRu ? 'Tudor Shandrov · Технические заметки' : 'Tudor Shandrov · Technical Notes'} href={rssHref} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2" />
    <link rel="icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="shell nav">
        <a class="brand" href={homeHref}>Tudor Shandrov <span>{isRu ? '/ Технические заметки' : '/ Technical Notes'}</span></a>
        <nav aria-label={isRu ? 'Основная навигация' : 'Primary navigation'}>
          <a href={notesHref}>{isRu ? 'Заметки' : 'Notes'}</a>
          <a href={topicsHref}>{isRu ? 'Темы' : 'Topics'}</a>
          <a href="https://shandrov.ru">{isRu ? 'Портфолио ↗' : 'Portfolio ↗'}</a>
          <a href="https://github.com/greksw">GitHub ↗</a>
          <a href={languageHref} aria-label={isRu ? 'Switch to English' : 'Переключить на русский'}>{isRu ? 'EN' : 'RU'}</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <span>© {new Date().getFullYear()} Tudor Shandrov</span>
        <span>{isRu ? 'Заметки по инфраструктурной инженерии · notes.shandrov.ru' : 'Infrastructure engineering notes · notes.shandrov.ru'}</span>
      </div>
    </footer>
  </body>
</html>
