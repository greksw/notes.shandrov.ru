---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => data.lang === 'en');
  const translations = await getCollection('notes', ({ data }) => data.lang === 'ru');
  return notes.map((note) => {
    const key = note.data.translationKey ?? note.id;
    const translation = translations.find((item) => item.data.translationKey === key);
    const alternateHref = translation ? `/ru/notes/${translation.id.replace(/^ru\//, '')}/` : '/ru/';
    return { params: { id: note.id }, props: { note, alternateHref } };
  });
}

const { note, alternateHref } = Astro.props;
const { Content } = await render(note);
---

<BaseLayout title={`${note.data.title} · Tudor Shandrov`} description={note.data.description} lang="en" alternateHref={alternateHref}>
  <article class="article">
    <a href="/notes/">← All notes</a>
    <div class="eyebrow" style="margin-top:32px">{note.data.category}</div>
    <h1>{note.data.title}</h1>
    <p class="lead">{note.data.description}</p>
    <div class="note-meta meta">
      <span>Status: {note.data.status}</span>
      <span>Published: {note.data.published.toISOString().slice(0,10)}</span>
      <span>Updated: {note.data.updated.toISOString().slice(0,10)}</span>
    </div>
    {note.data.testedOn.length > 0 && <p class="notice"><strong>Tested on:</strong> {note.data.testedOn.join(' · ')}</p>}
    <Content />
  </article>
</BaseLayout>
