---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const notes = (await getCollection('notes')).sort((a,b) => b.data.updated.valueOf() - a.data.updated.valueOf());
---
<BaseLayout title="Notes · Tudor Shandrov" description="Infrastructure engineering notes by Tudor Shandrov.">
  <section class="hero"><div class="shell"><div class="eyebrow">Notes</div><h1>Operational knowledge, kept explicit.</h1><p class="lead">Current runbooks, troubleshooting records and architecture notes. Legacy material is marked rather than silently presented as current practice.</p></div></section>
  <section class="section shell"><div class="grid">{notes.map((note) => <a class="card" href={`/notes/${note.id}/`}><div class="meta"><span>{note.data.status}</span><span>{note.data.category}</span><span>{note.data.updated.toISOString().slice(0,10)}</span></div><h3>{note.data.title}</h3><p>{note.data.description}</p><div class="tags">{note.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div></a>)}</div></section>
</BaseLayout>
