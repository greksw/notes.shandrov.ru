---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
const notes = await getCollection('notes', ({ data }) => data.lang === 'ru');
const categories: string[] = [...new Set<string>(notes.map((note: any): string => String(note.data.category)))].sort();
const tags: string[] = [...new Set<string>(notes.flatMap((note: any) => note.data.tags.map((tag: string) => String(tag))))].sort();
const slug = (value: string) => value.toLowerCase().replaceAll(' ', '-').replaceAll('&', 'and');
const noteHref = (id: string) => `/ru/notes/${id.replace(/^ru\//, '')}/`;
---
<BaseLayout title="Темы · Tudor Shandrov" description="Темы технических заметок Tudor Shandrov по инфраструктурной инженерии." lang="ru" alternateHref="/topics/">
  <section class="hero"><div class="shell"><div class="eyebrow">Индекс</div><h1>Темы</h1><p class="lead">База знаний организована по эксплуатационным направлениям; продукты и технологии остаются вторичными тегами.</p></div></section>
  <section class="section shell"><div class="section-head"><h2>Направления</h2></div>{categories.map((category: string) => <section id={slug(category)} style="margin-bottom:42px"><h3>{category}</h3><div class="grid">{notes.filter((note: any) => note.data.category === category).map((note: any) => <a class="card" href={noteHref(note.id)}><h3>{note.data.title}</h3><p>{note.data.description}</p></a>)}</div></section>)}</section>
  <section class="section shell"><div class="section-head"><h2>Технологические теги</h2></div><div class="topic-list">{tags.map((tag: string) => <span class="tag">{tag}</span>)}</div></section>
</BaseLayout>
